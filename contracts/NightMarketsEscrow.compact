pragma language_version >= 0.20;

import CompactStandardLibrary;

enum EscrowState {
  OPEN,
  FUNDED,
  RELEASED,
  DISPUTED,
  REFUNDED
}

export ledger escrow_state:  Map<Bytes<32>, EscrowState>;
export ledger seller_commit: Map<Bytes<32>, Bytes<32>>;
export ledger buyer_commit:  Map<Bytes<32>, Bytes<32>>;
export ledger amount_night:  Map<Bytes<32>, Uint<64>>;
// Payout addresses: needed so the server wallet can send real NIGHT on release/refund.
// Unshielded NIGHT is a public UTXO — recipient address is inherently public here,
// same tradeoff as any Ethereum escrow. ZK auth (who can authorize) is still enforced
// by the commitment checks. Empty = address not yet provided.
export ledger seller_addr:   Map<Bytes<32>, Bytes<32>>;  // orderId → seller NIGHT address
export ledger buyer_addr:    Map<Bytes<32>, Bytes<32>>;  // orderId → buyer NIGHT address
ledger round: Counter;
export ledger vote_for:     Map<Bytes<32>, Uint<64>>;
export ledger vote_against: Map<Bytes<32>, Uint<64>>;
export ledger vote_abstain: Map<Bytes<32>, Uint<64>>;
ledger has_voted: Map<Bytes<32>, Boolean>;

// Initializable + Pausable
ledger _is_initialized: Boolean;
export ledger _is_paused:      Boolean;
export ledger admin_commit:    Bytes<32>;

witness localSecretKey(): Bytes<32>;
witness voterNightBalance(): Uint<64>;

circuit callerCommitment(domain: Bytes<32>): Bytes<32> {
  const sk = localSecretKey();
  const contractAddr = kernel.self().bytes;
  return persistentHash<Vector<3, Bytes<32>>>([domain, contractAddr, sk]);
}

circuit assertNotPaused(): [] {
  assert(_is_paused == false, "contract is paused");
}

circuit assertOnlyAdmin(): [] {
  assert(_is_initialized, "not initialized");
  const com = callerCommitment(pad(32, "admin"));
  assert(disclose(com) == admin_commit, "not admin");
}

export circuit initialize(): [] {
  assert(_is_initialized == false, "already initialized");
  const com = callerCommitment(pad(32, "admin"));
  admin_commit = disclose(com);
  _is_initialized = true;
}

export circuit pause(): [] {
  assertOnlyAdmin();
  _is_paused = true;
}

export circuit unpause(): [] {
  assertOnlyAdmin();
  _is_paused = false;
}

export circuit isPaused(): Boolean {
  return _is_paused;
}

export circuit createListing(orderId: Bytes<32>, amountNight: Uint<64>, sellerNightAddr: Bytes<32>): Bytes<32> {
  assertNotPaused();
  const com  = callerCommitment(pad(32, "seller"));
  const oid  = disclose(orderId);
  const amt  = disclose(amountNight);
  const c    = disclose(com);
  const addr = disclose(sellerNightAddr);
  assert(escrow_state.member(oid) == false, "listing exists");
  escrow_state.insert(oid, EscrowState.OPEN);
  seller_commit.insert(oid, c);
  seller_addr.insert(oid, addr);
  amount_night.insert(oid, amt);
  round.increment(1);
  return c;
}

export circuit fundEscrow(orderId: Bytes<32>, amountNight: Uint<64>, buyerNightAddr: Bytes<32>): Bytes<32> {
  assertNotPaused();
  const com  = callerCommitment(pad(32, "buyer"));
  const oid  = disclose(orderId);
  const amt  = disclose(amountNight);
  const c    = disclose(com);
  const addr = disclose(buyerNightAddr);
  const state = escrow_state.lookup(oid);
  assert(state == EscrowState.OPEN, "not open");
  // Verify buyer is paying the listed price — prevents underpaying or overpaying exploits
  const listedAmt = amount_night.lookup(oid);
  assert(amt == listedAmt, "amount mismatch");
  buyer_commit.insert(oid, c);
  buyer_addr.insert(oid, addr);
  escrow_state.insert(oid, EscrowState.FUNDED);
  round.increment(1);
  return c;
}

// Returns seller's NIGHT address so the server can send real NIGHT to them.
export circuit releaseEscrow(orderId: Bytes<32>): Bytes<32> {
  assertNotPaused();
  const callerCom = callerCommitment(pad(32, "buyer"));
  const oid = disclose(orderId);
  const storedCom = buyer_commit.lookup(oid);
  assert(disclose(callerCom) == storedCom, "not authorized");
  const state = escrow_state.lookup(oid);
  assert(state == EscrowState.FUNDED, "not funded");
  escrow_state.insert(oid, EscrowState.RELEASED);
  round.increment(1);
  return seller_addr.lookup(oid);
}

export circuit disputeEscrow(orderId: Bytes<32>): Boolean {
  assertNotPaused();
  const oid = disclose(orderId);
  const state = escrow_state.lookup(oid);
  assert(state == EscrowState.FUNDED, "not funded");
  // Either party can raise a dispute — seller needs recourse if buyer goes silent
  const buyerCom  = callerCommitment(pad(32, "buyer"));
  const sellerCom = callerCommitment(pad(32, "seller"));
  const callerIsB = disclose(buyerCom)  == buyer_commit.lookup(oid);
  const callerIsS = disclose(sellerCom) == seller_commit.lookup(oid);
  assert(callerIsB || callerIsS, "not authorized");
  escrow_state.insert(oid, EscrowState.DISPUTED);
  round.increment(1);
  return true;
}

// Returns buyer's NIGHT address so the server can refund real NIGHT to them.
export circuit refundEscrow(orderId: Bytes<32>): Bytes<32> {
  assertNotPaused();
  const callerCom = callerCommitment(pad(32, "seller"));
  const oid = disclose(orderId);
  const storedCom = seller_commit.lookup(oid);
  assert(disclose(callerCom) == storedCom, "not authorized");
  const state = escrow_state.lookup(oid);
  assert(state == EscrowState.OPEN || state == EscrowState.DISPUTED, "invalid state");
  escrow_state.insert(oid, EscrowState.REFUNDED);
  round.increment(1);
  return buyer_addr.lookup(oid);
}

// Seller calls this after the 14-day escrow deadline if buyer has neither released
// nor disputed. Time enforcement is validated server-side (Stage 1 semi-trusted
// architecture). Stage 2 will add on-chain block height verification once the
// Compact kernel exposes that primitive.
export circuit expireEscrow(orderId: Bytes<32>): Bytes<32> {
  assertNotPaused();
  const callerCom = callerCommitment(pad(32, "seller"));
  const oid = disclose(orderId);
  const storedCom = seller_commit.lookup(oid);
  assert(disclose(callerCom) == storedCom, "not authorized");
  const state = escrow_state.lookup(oid);
  assert(state == EscrowState.FUNDED, "not funded");
  escrow_state.insert(oid, EscrowState.RELEASED);
  round.increment(1);
  return seller_addr.lookup(oid);
}

export circuit castVote(proposalId: Bytes<32>, choice: Uint<8>): Boolean {
  const sk = localSecretKey();
  const contractAddr = kernel.self().bytes;
  const voterCom = persistentHash<Vector<2, Bytes<32>>>([contractAddr, sk]);
  const voterComPublic = disclose(voterCom);
  assert(has_voted.member(voterComPublic) == false, "already voted");
  const pid    = disclose(proposalId);
  const ch     = disclose(choice);
  const rawWeight = voterNightBalance();
  const maxWeight = 1000000000000 as Uint<64>;
  const weight = disclose(rawWeight > maxWeight ? maxWeight : rawWeight);
  assert(weight > (0 as Uint<64>), "zero weight");
  if (ch == (0 as Uint<8>)) {
    const prev = vote_for.member(pid) ? vote_for.lookup(pid) : (0 as Uint<64>);
    vote_for.insert(pid, (prev + weight) as Uint<64>);
  } else {
    if (ch == (1 as Uint<8>)) {
      const prev = vote_against.member(pid) ? vote_against.lookup(pid) : (0 as Uint<64>);
      vote_against.insert(pid, (prev + weight) as Uint<64>);
    } else {
      const prev = vote_abstain.member(pid) ? vote_abstain.lookup(pid) : (0 as Uint<64>);
      vote_abstain.insert(pid, (prev + weight) as Uint<64>);
    }
  }
  has_voted.insert(voterComPublic, true);
  round.increment(1);
  return true;
}
