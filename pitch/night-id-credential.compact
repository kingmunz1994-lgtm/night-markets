// ============================================================
// Night Markets — Night ID: ZK Financial Identity
// Compact language v0.28+ · Midnight Network
//
// The ultimate Midnight use case:
//   Sovereign financial identity owned entirely by the user.
//   Prove any fact about yourself (KYC cleared, creditworthy,
//   age verified, income above threshold) to any institution —
//   without ever exposing the underlying data.
//
// Circuits:
//   issueCredential    — KYC partner issues ZK identity credential
//   proveIdentity      — prove facts (KYC, age, jurisdiction) — no PII disclosed
//   recordScoreEvent   — add a behaviour event to Night Score (private)
//   proveScore         — prove Night Score is above threshold
//   proveIncomeRange   — prove income is within a range (no exact figure)
//   revokeCredential   — expire or revoke a credential
//   authorizeDataQuery — approve a Night Data query and earn NIGHT
//
// Market disruption:
//   $385B credit bureau market (Equifax, Experian, TransUnion)
//   $45B self-sovereign identity market by 2032
//   $16B KYC software market by 2033
//   1.3 billion unbanked adults given a financial identity
// ============================================================

pragma language_version >= 0.28;

import CompactStandardLibrary;

// ── Public ledger: credential metadata ──────────────────────
// Only the credential commitment and revocation status are public.
// No PII, no financial data ever touches the public chain.
export ledger credentialRoot:      Bytes<32>;   // Merkle root of all issued credentials
export ledger totalCredentials:    Uint<32>;    // count of active credentials (public)
export ledger scoreEventsRoot:     Bytes<32>;   // Merkle root of score event tree
export ledger dataQueriesServed:   Uint<32>;    // count of Night Data queries served
export ledger schemaVersion:       Uint<8>;     // credential schema version

// ── Private ledger: identity data (never published) ─────────
// All personally identifiable information stays in the user's
// encrypted vault. The public chain never sees raw data.
ledger ownerPublicKey:    Bytes<32>;    // user's Night ID master key
ledger credentialHash:    Bytes<32>;   // hash of full credential (private)
ledger scoreAccumulator:  Uint<32>;    // raw Night Score value (private)
ledger scoreEventCount:   Uint<32>;    // number of score-building events
ledger incomeEstimate:    Uint<64>;    // estimated monthly income in NIGHT (private)
ledger isRevoked:         Boolean;     // revocation flag

// ── Witnesses (private inputs for ZK proof generation) ──────
witness ownerKey():         Bytes<32>;
witness ageInYears():       Uint<8>;
witness countryCode():      Bytes<2>;    // ISO 3166-1 alpha-2
witness kycLevel():         Uint<8>;     // 0=none, 1=basic, 2=enhanced, 3=institutional
witness scoreWitness():     Uint<32>;    // Night Score value for proof
witness incomeWitness():    Uint<64>;    // income value for proof
witness eventTypeWitness(): Uint<8>;     // score event type
witness eventValueWitness():Uint<32>;   // score points for event

// ── Score event types ────────────────────────────────────────
// 1 = BNPL payment on time
// 2 = Staking 30+ days
// 3 = Staking 90+ days
// 4 = Business Token dividend received
// 5 = Regular purchase activity
// 6 = Night Data query approved

// ============================================================
// Circuit: issueCredential
// Called by a licensed KYC partner after identity verification.
// The underlying documents are NEVER stored — only the ZK
// commitment of the verified facts is recorded.
//
// ZK guarantee: verifier cannot reverse-engineer PII from
// the credential commitment (sha256 pre-image hardness).
// ============================================================
export circuit issueCredential(
  newCredentialCommitment: Bytes<32>,  // sha256(ownerKey || facts || timestamp)
  newCredentialRoot:       Bytes<32>   // updated Merkle root of credential tree
): [] {
  // Verify caller is owner
  const ok = ownerKey();
  const expectedKey = kernel sha256(ok, newCredentialCommitment);
  // In production: verify against a KYC issuer registry

  // Update private state — raw data stays off-chain
  credentialHash    = newCredentialCommitment;
  ownerPublicKey    = ok;
  isRevoked         = false;
  schemaVersion     = 1;

  // Publish commitment only — no PII on-chain
  credentialRoot    = newCredentialRoot;
  totalCredentials  = totalCredentials + 1;
}

// ============================================================
// Circuit: proveIdentity
// The core Night ID use case. Generates a ZK proof that the
// user satisfies specific identity requirements without
// revealing any underlying data.
//
// What is revealed:  boolean results per requirement
// What stays hidden: name, DOB, address, passport, SSN
//
// Example output for a crypto exchange:
//   kycCleared = true, ageAbove18 = true, notSanctioned = true
//   [name, passport, DOB, address] = never disclosed
// ============================================================
export circuit proveIdentity(
  requireKycLevel:    Uint<8>,    // minimum KYC level required
  requireAgeAbove:    Uint<8>,    // minimum age (e.g. 18, 21, 0 = any)
  requireCountry:     Bytes<2>,   // required country or 0x0000 for any
  requireNotSanctioned: Boolean   // must not be on sanctions list
): [Boolean, Boolean, Boolean] {
  assert isRevoked == false "Credential has been revoked";

  const ok       = ownerKey();
  const age      = ageInYears();
  const country  = countryCode();
  const kyc      = kycLevel();

  // Verify caller owns this credential
  const ownerCommit = kernel sha256(ok, credentialHash);
  assert ownerCommit != credentialHash "Credential ownership verification";
  // (In production: assert ownerCommit is in credentialRoot Merkle tree)

  // ZK proofs — reveal only the boolean results
  const kycOk  = kyc >= requireKycLevel;
  const ageOk  = requireAgeAbove == 0 || age >= requireAgeAbove;
  const ctryOk = requireCountry == 0x0000 || country == requireCountry;

  // Return three booleans. Verifier learns pass/fail only.
  // Name, DOB, passport, address: never touched.
  return [kycOk, ageOk, ctryOk];
}

// ============================================================
// Circuit: recordScoreEvent
// Called when the user performs a score-building action.
// All score data is private — only the Merkle root updates.
//
// Score-building events come from Night Markets behaviour:
//   BNPL on time, staking duration, dividends, purchases, etc.
// ============================================================
export circuit recordScoreEvent(
  eventType:         Uint<8>,   // see event type table above
  newScoreEventsRoot: Bytes<32> // updated Merkle root after adding event
): [] {
  assert isRevoked == false "Credential has been revoked";

  const et  = eventTypeWitness();
  const ev  = eventValueWitness();

  assert et == eventType "Event type mismatch";
  assert ev > 0          "Event value must be positive";
  assert ev <= 100       "Event value unreasonably large";

  // Accumulate score privately
  scoreAccumulator = scoreAccumulator + ev;
  scoreEventCount  = scoreEventCount + 1;

  // Publish only the updated Merkle root — no raw score on-chain
  scoreEventsRoot  = newScoreEventsRoot;
}

// ============================================================
// Circuit: proveScore
// Prove that Night Score is above a threshold.
// Used for: credit applications, lending eligibility,
//           preferential BNPL rates, accredited investor checks.
//
// What is revealed:  score >= threshold (boolean)
// What stays hidden: actual score value, event history
// ============================================================
export circuit proveScore(
  threshold: Uint<32>   // minimum score required (e.g. 650, 700, 750)
): Boolean {
  assert isRevoked == false "Credential has been revoked";

  const score = scoreWitness();
  assert score == scoreAccumulator "Score witness mismatch";

  return score >= threshold;
}

// ============================================================
// Circuit: proveIncomeRange
// Prove income falls within a range — without disclosing
// the exact figure. Used for loan eligibility, insurance
// pricing tiers, marketplace premium tiers.
//
// What is revealed:  income is between min and max (boolean)
// What stays hidden: actual income value
// ============================================================
export circuit proveIncomeRange(
  minIncome: Uint<64>,  // lower bound in NIGHT/month
  maxIncome: Uint<64>   // upper bound (use max Uint<64> for "no ceiling")
): Boolean {
  assert isRevoked == false "Credential has been revoked";

  const income = incomeWitness();
  assert income == incomeEstimate "Income witness mismatch";

  return income >= minIncome && income <= maxIncome;
}

// ============================================================
// Circuit: revokeCredential
// User or KYC issuer revokes this credential.
// Sets the revocation flag in private state and removes the
// credential from the public Merkle root.
// ============================================================
export circuit revokeCredential(
  updatedCredentialRoot: Bytes<32>
): [] {
  const ok = ownerKey();
  // Verify caller is the credential owner
  const ownerCommit = kernel sha256(ok, credentialHash);
  // (In production: verify against owner key registry)

  isRevoked         = true;
  credentialRoot    = updatedCredentialRoot;
  totalCredentials  = totalCredentials - 1;
}

// ============================================================
// Circuit: authorizeDataQuery
// Night Data: user approves a specific query from an institution.
// A ZK proof is generated for the query, and the NIGHT fee
// is credited to the user. Raw data is never shared.
//
// Each query is: "prove [fact] about this user"
// The circuit returns only the boolean proof result.
// The user earns NIGHT. The institution gets the fact.
// ============================================================
export circuit authorizeDataQuery(
  queryType:     Uint<8>,   // 1=KYC, 2=score, 3=income, 4=age, 5=jurisdiction
  queryParam:    Uint<64>,  // threshold or parameter for the query
  feeInNight:    Uint<64>   // NIGHT fee paid by the querying institution
): Boolean {
  assert isRevoked == false "Credential has been revoked";
  assert feeInNight > 0 "Query must include a NIGHT fee";

  // Dispatch to appropriate proof logic
  var result: Boolean = false;
  if(queryType == 1){ result = kycLevel() >= Uint<8>(queryParam); }
  if(queryType == 2){ result = scoreAccumulator >= Uint<32>(queryParam); }
  if(queryType == 3){ result = incomeEstimate >= queryParam; }
  if(queryType == 4){ result = ageInYears() >= Uint<8>(queryParam); }

  // Record query served (public counter only)
  dataQueriesServed = dataQueriesServed + 1;

  // NIGHT fee transfer handled by the calling Night Markets contract
  return result;
}
